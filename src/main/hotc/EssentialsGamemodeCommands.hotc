// --- Real port of GamemodeShortcutCommand.java ---
//
// Same "call the real Java directly" approach every other ported command in this project uses --
// `ServerPlayer.setGameMode` and the real `GameType` enum constants (`context.hc`'s own new
// `GameTypeHc`), nothing reimplemented. The four shortcuts (`gmc`/`gms`/`gma`/`gmsp`) share one
// implementation, same as the original's own loop.
//
// The mode is carried as a plain `Int` code (0=survival .. 3=spectator) and turned back into the
// real `GameTypeHc` constant fresh at each use (`hc_game_type`), rather than captured as an
// extern-class value in two separate lambdas (the no-target and `<player>` forms) -- sidesteps any
// "use of moved value" question entirely, same reasoning `EssentialsConfigScreenHc.hotc` already
// gives for re-fetching `Minecraft::getInstance().font` instead of sharing one local.
//
// `hc`-prefixed literals (`/hcgmc`/`/hcgms`/`/hcgma`/`/hcgmsp`) -- same side-by-side-pilot
// reasoning every other ported command file already gives; the real shortcuts stay registered and
// untouched. Same disclosed scope cut as the heal/feed/god/fly ports: the original's `<player>`
// form also requires op level 2, not ported here.

fn hc_game_type(code: Int) -> GameTypeHc {
    if code == 0 { return GameTypeHc::SURVIVAL; }
    if code == 1 { return GameTypeHc::CREATIVE; }
    if code == 2 { return GameTypeHc::ADVENTURE; }
    return GameTypeHc::SPECTATOR;
}

fn hc_set_gamemode(source: &CommandSourceStackHc, target: ServerPlayer, code: Int, named: Bool) -> Int {
    let mode_name = hc_game_type(code).getName();
    target.setGameMode(hc_game_type(code));
    target.sendSystemMessage(Component::literal("Gamemode set to {mode_name}.") as Component);
    if named {
        let display_name = target.getGameProfile().getName();
        source.sendSuccess(|| { return Component::literal("Set {display_name}'s gamemode to {mode_name}.") as JObjectCmd; }, true);
    }
    return 1;
}

fn hc_gm_self(source: CommandSourceStackHc, code: Int) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    return hc_set_gamemode(&source, player, code, false);
}

fn hc_gm_named(source: CommandSourceStackHc, target_name: String, code: Int) -> Int {
    let target = source.getServer().getPlayerList().getPlayerByName(target_name);
    if target == null {
        source.sendFailure(Component::literal("Player \"{target_name}\" isn't online.") as Component);
        return 0;
    }
    return hc_set_gamemode(&source, target, code, true);
}

fn hc_register_gm(dispatcher: &CommandDispatcherSrc, literal_name: String, code: Int) {
    let player_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_gm_named(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"), code);
    });
    let builder = CommandsHc::literal(literal_name)
        .executes(|ctx| { return hc_gm_self(ctx.getSource() as CommandSourceStackHc, code); })
        .then(player_arg);
    dispatcher.register(builder as LiteralArgumentBuilderSrc);
}

pub fn register_real_gamemode_commands(dispatcher: CommandDispatcherSrc) {
    hc_register_gm(&dispatcher, "hcgms", 0);
    hc_register_gm(&dispatcher, "hcgmc", 1);
    hc_register_gm(&dispatcher, "hcgma", 2);
    hc_register_gm(&dispatcher, "hcgmsp", 3);
}
