

fn hc_game_type(code: Int) -> GameTypeHc {
    if code == 0 { return GameTypeHc::SURVIVAL; }
    if code == 1 { return GameTypeHc::CREATIVE; }
    if code == 2 { return GameTypeHc::ADVENTURE; }
    return GameTypeHc::SPECTATOR;
}

fn hc_set_gamemode(source: &CommandSourceStackHc, target: ServerPlayer, code: Int, named: Bool) -> Int {
    let mode_name = hc_game_type(code).getName();
    target.setGameMode(hc_game_type(code));
    target.sendSystemMessage(Component::literal("Gamemode set to {mode_name}.") as Component);
    if named {
        let display_name = target.getGameProfile().getName();
        source.sendSuccess(|| { return Component::literal("Set {display_name}'s gamemode to {mode_name}.") as JObjectCmd; }, true);
    }
    return 1;
}

fn hc_gm_self(source: CommandSourceStackHc, code: Int) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    return hc_set_gamemode(&source, player, code, false);
}

fn hc_gm_named(source: CommandSourceStackHc, target_name: String, code: Int) -> Int {
    let target = source.getServer().getPlayerList().getPlayerByName(target_name);
    if target == null {
        source.sendFailure(Component::literal("Player \"{target_name}\" isn't online.") as Component);
        return 0;
    }
    return hc_set_gamemode(&source, target, code, true);
}

fn hc_register_gm(dispatcher: &CommandDispatcherSrc, real_name: String, twin_name: String, code: Int) {
    let player_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc)
        .requires(|src| { return ess_op_required(src); })
        .executes(|ctx| {
        return hc_gm_named(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"), code);
    });
    let builder = ess_literal(real_name, twin_name, "GAMEMODE")
        .executes(|ctx| { return hc_gm_self(ctx.getSource() as CommandSourceStackHc, code); })
        .then(player_arg);
    dispatcher.register(builder as LiteralArgumentBuilderSrc);
}

pub fn register_real_gamemode_commands(dispatcher: CommandDispatcherSrc) {
    hc_register_gm(&dispatcher, "gms", "hcgms", 0);
    hc_register_gm(&dispatcher, "gmc", "hcgmc", 1);
    hc_register_gm(&dispatcher, "gma", "hcgma", 2);
    hc_register_gm(&dispatcher, "gmsp", "hcgmsp", 3);
}
