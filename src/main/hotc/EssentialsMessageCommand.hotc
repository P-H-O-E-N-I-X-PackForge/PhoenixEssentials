

fn hc_send_message(source: CommandSourceStackHc, target_name: String, message: String) -> Int {
    let sender = source.getPlayer();
    if sender == null { return 0; }
    if !EssentialsHcModeHc::featureEnabled(&sender, "social") {
        source.sendFailure(Component::literal("Social commands aren't available here right now.") as Component);
        return 0;
    }
    let target = source.getServer().getPlayerList().getPlayerByName(target_name);
    if target == null {
        source.sendFailure(Component::literal("Player \"{target_name}\" isn't online.") as Component);
        return 0;
    }
    let error = EssentialsHcServerBridgeHc::sendDirectMessage(sender, target, message);
    if error != null {
        source.sendFailure(Component::literal(error) as Component);
        return 0;
    }
    return 1;
}

fn hc_reply_message(source: CommandSourceStackHc, message: String) -> Int {
    let sender = source.getPlayer();
    if sender == null { return 0; }
    let target_name = EssentialsHcServerBridgeHc::getLastMessagedName(source.getServer(), sender);
    if target_name == null {
        source.sendFailure(Component::literal("You have no one to reply to.") as Component);
        return 0;
    }
    return hc_send_message(source, target_name, message);
}

fn hc_register_msg_alias(dispatcher: &CommandDispatcherSrc, name: String) {
    let message_arg = CommandsHc::argument("message", StringArgumentTypeSrc::greedyString() as ArgumentTypeSrc).executes(|ctx| {
        return hc_send_message(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"), StringArgumentTypeSrc::getString(ctx, "message"));
    });
    let player_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).then(message_arg);
    let msg_builder = ess_literal(name, name, "MSG").then(player_arg);
    dispatcher.register(msg_builder as LiteralArgumentBuilderSrc);
}

fn hc_register_reply_alias(dispatcher: &CommandDispatcherSrc, name: String) {
    let reply_message_arg = CommandsHc::argument("message", StringArgumentTypeSrc::greedyString() as ArgumentTypeSrc).executes(|ctx| {
        return hc_reply_message(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "message"));
    });
    let reply_builder = ess_literal(name, name, "MSG").then(reply_message_arg);
    dispatcher.register(reply_builder as LiteralArgumentBuilderSrc);
}

pub fn register_real_message_commands(dispatcher: CommandDispatcherSrc) {
    if EssentialsHcModeHc::takeover() {
        hc_register_msg_alias(&dispatcher, "msg");
        hc_register_msg_alias(&dispatcher, "tell");
        hc_register_reply_alias(&dispatcher, "r");
        hc_register_reply_alias(&dispatcher, "reply");
    } else {
        hc_register_msg_alias(&dispatcher, "hcmsg");
        hc_register_reply_alias(&dispatcher, "hcr");
    }
}
