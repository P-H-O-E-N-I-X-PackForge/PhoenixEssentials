

fn hc_tpx(source: CommandSourceStackHc, target_level: ServerLevel) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    let target = EssentialsHcServerBridgeHc::tpxLocation(player, target_level);
    if target == null {
        source.sendFailure(Component::literal("You're already in that dimension.") as Component);
        return 0;
    }
    let label = EssentialsHcServerBridgeHc::dimensionLabel(target_level);
    TeleportExecutorHc::request(player, target, "tpx", label);
    return 1;
}

pub fn register_real_tpx_command(dispatcher: CommandDispatcherSrc) {
    let dimension_arg = CommandsHc::argument("dimension", DimensionArgumentSrc::dimension() as ArgumentTypeSrc).executes(|ctx| {
        return hc_tpx(ctx.getSource() as CommandSourceStackHc, DimensionArgumentSrc::getDimension(ctx, "dimension"));
    });
    let tpx_builder = ess_literal("tpx", "hctpx", "TPX").then(dimension_arg);
    dispatcher.register(tpx_builder as LiteralArgumentBuilderSrc);
}
