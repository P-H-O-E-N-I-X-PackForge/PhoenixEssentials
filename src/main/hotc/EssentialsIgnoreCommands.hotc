// --- Real port of IgnoreCommand.java ---
//
// Same "call the real Java directly" approach every other ported command in this project uses --
// `EssentialsHcServerBridgeHc::setIgnored` (`EssentialsBridge.hotc`) consolidates the real
// `Set<UUID>` add/remove into one call, rather than binding `java.util.UUID`/`Set` individually
// for this one real caller.
//
// `hc`-prefixed command literals (`/hcignore`/`/hcunignore`) -- same side-by-side-pilot reasoning
// every other ported command file in this project already gives; the real `/ignore`/`/unignore`
// (`IgnoreCommand.java`) stay registered and untouched.

fn hc_set_ignored(source: CommandSourceStackHc, target_name: String, ignore: Bool) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    let target = source.getServer().getPlayerList().getPlayerByName(target_name);
    if target == null {
        source.sendFailure(Component::literal("Player \"{target_name}\" isn't online.") as Component);
        return 0;
    }
    if target == player {
        source.sendFailure(Component::literal("You can't ignore yourself.") as Component);
        return 0;
    }
    let data = ess_player_data(&source);
    if data == null { return 0; }
    EssentialsHcServerBridgeHc::setIgnored(&data, target, ignore);
    let display_name = target.getName().getString();
    if ignore {
        source.sendSuccess(|| { return Component::literal("Now ignoring {display_name}.") as JObjectCmd; }, false);
    } else {
        source.sendSuccess(|| { return Component::literal("No longer ignoring {display_name}.") as JObjectCmd; }, false);
    }
    return 1;
}

pub fn register_real_ignore_commands(dispatcher: CommandDispatcherSrc) {
    let ignore_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_set_ignored(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"), true);
    });
    let ignore_builder = CommandsHc::literal("hcignore").then(ignore_arg);
    dispatcher.register(ignore_builder as LiteralArgumentBuilderSrc);

    let unignore_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_set_ignored(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"), false);
    });
    let unignore_builder = CommandsHc::literal("hcunignore").then(unignore_arg);
    dispatcher.register(unignore_builder as LiteralArgumentBuilderSrc);
}
