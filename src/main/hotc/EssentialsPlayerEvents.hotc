

extern class PlayerTickEventHc = "net.neoforged.neoforge.event.tick.PlayerTickEvent$Post" {
    fn getEntity(&self) -> Player;
}

extern class PlayerLoggedInEventHc = "net.neoforged.neoforge.event.entity.player.PlayerEvent$PlayerLoggedInEvent" {
    fn getEntity(&self) -> Player;
}

extern class PlayerLoggedOutEventHc = "net.neoforged.neoforge.event.entity.player.PlayerEvent$PlayerLoggedOutEvent" {
    fn getEntity(&self) -> Player;
}

extern class LivingDeathEventHc = "net.neoforged.neoforge.event.entity.living.LivingDeathEvent" {
    fn getEntity(&self) -> LivingEntity;
}

fn ess_on_player_tick(e: JObjectEvent) {
    let ev = e as PlayerTickEventHc;
    let who = ev.getEntity();
    if !(who is ServerPlayer) { return; }
    let player = who as ServerPlayer;
    let opt = EssentialsCapabilityProviderHc::lookup(player as JObjectEssCap);
    let data_obj = opt.orElse(null);
    if data_obj == null { return; }
    (data_obj as EssentialsPlayerDataHc).addPlaytimeTicks(1L);
}

fn ess_on_player_logged_in(e: JObjectEvent) {
    let who = (e as PlayerLoggedInEventHc).getEntity();
    if !(who is ServerPlayer) { return; }
    sup_record_seen(who as ServerPlayer);
}

fn ess_on_player_logged_out(e: JObjectEvent) {
    let who = (e as PlayerLoggedOutEventHc).getEntity();
    if !(who is ServerPlayer) { return; }
    sup_record_seen(who as ServerPlayer);
}

fn ess_on_living_death(e: JObjectEvent) {
    if !sup_cfg_bool("backAfterDeath") { return; }
    let who = (e as LivingDeathEventHc).getEntity();
    if !(who is ServerPlayer) { return; }
    let player = who as ServerPlayer;
    let opt = EssentialsCapabilityProviderHc::lookup(player as JObjectEssCap);
    let data_obj = opt.orElse(null);
    if data_obj == null { return; }
    (data_obj as EssentialsPlayerDataHc).setBack(NamedLocationHc::of(player));
}

pub fn register_player_events() {
    let bus = MinecraftForgeHc::EVENT_BUS;
    bus.addListener(EventPriorityHc::NORMAL, false,
        class("net.neoforged.neoforge.event.tick.PlayerTickEvent$Post") as JClassNet,
        |e| { ess_on_player_tick(e); });
    bus.addListener(EventPriorityHc::NORMAL, false,
        class("net.neoforged.neoforge.event.entity.player.PlayerEvent$PlayerLoggedInEvent") as JClassNet,
        |e| { ess_on_player_logged_in(e); });
    bus.addListener(EventPriorityHc::NORMAL, false,
        class("net.neoforged.neoforge.event.entity.player.PlayerEvent$PlayerLoggedOutEvent") as JClassNet,
        |e| { ess_on_player_logged_out(e); });
    bus.addListener(EventPriorityHc::NORMAL, false,
        class("net.neoforged.neoforge.event.entity.living.LivingDeathEvent") as JClassNet,
        |e| { ess_on_living_death(e); });
}
