

fn ess_suggest_from_csv(builder: SuggestionsBuilderHc, csv: String) -> SuggestionsBuilderHc {
    var b = builder;
    if csv.length() > 0 {
        let names = csv.split(",");
        var i = 0;
        while i < names.length {
            b = b.suggest(names[i]);
            i = i + 1;
        }
    }
    return b;
}
