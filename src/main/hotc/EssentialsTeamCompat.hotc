// --- HC port of TeamCompat: optional team/guild backends, called directly (no reflection) ---
//
// Phoenix Guilds and FTB Teams are OPTIONAL: both stay `modCompileOnly` in build.gradle. This binds
// their real classes as `extern class`es and calls their real API (`GuildManager.get(level)
// .getGuildFor(uuid)`, `FTBTeamsAPI.api().getManager().getTeamForPlayerID(uuid)`) -- the same calls the
// Java `TeamCompat` made. The safety against a backend being absent is the same as in Java: each
// backend's calls sit behind `ModList.get().isLoaded("<modid>")`, so an absent mod's classes are never
// resolved (JVM linking is lazy -- an `invokestatic`/`invokeinterface` only resolves its class when it
// executes). Guild wins over FTB when a player is in both (same order as before).
//
// `TeamCompat.java` is now a thin facade over these `tc_*` functions for its Java callers (`TpaCommand`,
// the `tpa` shim); `/sethomelimit team` calls them directly from HC.

extern class TcModList = "net.minecraftforge.fml.ModList" {
    static fn get() -> TcModList;
    fn isLoaded(&self, modid: String) -> Bool;
}

extern class TcUuid = "java.util.UUID" {
    fn toString(&self) -> String;
}

extern class TcObject = "java.lang.Object" {}

extern class TcOptional = "java.util.Optional" {
    fn isPresent(&self) -> Bool;
    fn get(&self) -> TcObject;
}

extern class TcIterator = "java.util.Iterator" interface {
    fn hasNext(&self) -> Bool;
    fn next(&self) -> TcObject;
}

extern class TcSet = "java.util.Set" interface {
    fn iterator(&self) -> TcIterator;
}

extern class TcPlayer = "net.minecraft.server.level.ServerPlayer" {
    fn getUUID(&self) -> TcUuid;
    fn getServer(&self) -> MinecraftServerHc;
}

// Phoenix Guilds
extern class TcGuildManager = "net.phoenixvine.guilds.data.GuildManager" {
    static fn get(level: ServerLevel) -> TcGuildManager;
    fn getGuildFor(&self, id: TcUuid) -> TcOptional;
}
extern class TcGuild = "net.phoenixvine.guilds.data.Guild" {
    fn getId(&self) -> TcUuid;
    fn getName(&self) -> String;
    fn getMembers(&self) -> TcSet;
}

// FTB Teams
extern class TcFtbApi = "dev.ftb.mods.ftbteams.api.FTBTeamsAPI$API" interface {
    fn isManagerLoaded(&self) -> Bool;
    fn getManager(&self) -> TcFtbManager;
}
extern class TcFtbTeamsApi = "dev.ftb.mods.ftbteams.api.FTBTeamsAPI" {
    static fn api() -> TcFtbApi;
}
extern class TcFtbManager = "dev.ftb.mods.ftbteams.api.TeamManager" interface {
    fn getTeamForPlayerID(&self, id: TcUuid) -> TcOptional;
}
extern class TcFtbTeam = "dev.ftb.mods.ftbteams.api.Team" interface {
    fn getId(&self) -> TcUuid;
    fn isPartyTeam(&self) -> Bool;
    fn isServerTeam(&self) -> Bool;
    fn getName(&self) -> Component;
    fn getMembers(&self) -> TcSet;
}

// One lookup result: `found` false means "not on any team". `members` is newline-separated UUID strings,
// the caller excluded.
struct TcInfo {
    found: Bool,
    id: String,
    name: String,
    members: String,
}

fn tc_none() -> TcInfo {
    return TcInfo { found: false, id: "", name: "", members: "" };
}

fn tc_members_excluding(set: TcSet, me: String) -> String {
    var out = "";
    var first = true;
    let it = set.iterator();
    while it.hasNext() {
        let uuid = (it.next() as TcUuid).toString();
        if uuid != me {
            if first {
                out = uuid;
                first = false;
            } else {
                out = "{out}\n{uuid}";
            }
        }
    }
    return out;
}

fn tc_ftb_loaded() -> Bool {
    if !TcModList::get().isLoaded("ftbteams") { return false; }
    return TcFtbTeamsApi::api().isManagerLoaded();
}

fn tc_lookup(p: &TcPlayer) -> TcInfo {
    let me = p.getUUID().toString();

    if TcModList::get().isLoaded("phoenix_guilds") {
        let opt = TcGuildManager::get(p.getServer().overworld()).getGuildFor(p.getUUID());
        if opt.isPresent() {
            let guild = opt.get() as TcGuild;
            let gid = guild.getId().toString();
            return TcInfo { found: true, id: "guild:{gid}", name: guild.getName(), members: tc_members_excluding(guild.getMembers(), me) };
        }
    }

    if tc_ftb_loaded() {
        let opt = TcFtbTeamsApi::api().getManager().getTeamForPlayerID(p.getUUID());
        if opt.isPresent() {
            let team = opt.get() as TcFtbTeam;
            if team.isPartyTeam() || team.isServerTeam() {
                let tid = team.getId().toString();
                return TcInfo { found: true, id: "ftbteam:{tid}", name: team.getName().getString(), members: tc_members_excluding(team.getMembers(), me) };
            }
        }
    }

    return tc_none();
}

// ---- API for the Java facade ----

// "" when the player isn't on a team.
pub fn tc_team_id(player: &ServerPlayer) -> String {
    let p = player as TcPlayer;
    return tc_lookup(&p).id;
}

pub fn tc_team_name(player: &ServerPlayer) -> String {
    let p = player as TcPlayer;
    return tc_lookup(&p).name;
}

// Newline-separated teammate UUIDs (the player excluded), "" if none.
pub fn tc_teammates(player: &ServerPlayer) -> String {
    let p = player as TcPlayer;
    return tc_lookup(&p).members;
}

pub fn tc_any_backend() -> Int {
    if TcModList::get().isLoaded("phoenix_guilds") { return 1; }
    if tc_ftb_loaded() { return 1; }
    return 0;
}

// 1 if `a` and `b` share a team (a player is always their own teammate).
pub fn tc_are_teammates(a: &ServerPlayer, b: &ServerPlayer) -> Int {
    let pa = a as TcPlayer;
    let pb = b as TcPlayer;
    if pa.getUUID().toString() == pb.getUUID().toString() { return 1; }
    let ia = tc_lookup(&pa);
    if !ia.found { return 0; }
    let ib = tc_lookup(&pb);
    if ib.found && ia.id == ib.id { return 1; }
    return 0;
}
