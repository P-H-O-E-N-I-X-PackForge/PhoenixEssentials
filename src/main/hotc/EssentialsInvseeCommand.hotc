

fn hc_invsee(source: CommandSourceStackHc, target_name: String) -> Int {
    let viewer = source.getPlayer();
    if viewer == null { return 0; }
    let target = source.getServer().getPlayerList().getPlayerByName(target_name);
    if target == null {
        source.sendFailure(Component::literal("Player \"{target_name}\" isn't online.") as Component);
        return 0;
    }
    let error = EssentialsHcInvseeHc::open(viewer, target);
    if error != null {
        source.sendFailure(Component::literal(error) as Component);
        return 0;
    }
    return 1;
}

pub fn register_real_invsee_command(dispatcher: CommandDispatcherSrc) {
    let player_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_invsee(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"));
    });
    let invsee_builder = ess_literal("invsee", "hcinvsee", "INVSEE").then(player_arg);
    dispatcher.register(invsee_builder as LiteralArgumentBuilderSrc);
}
