

fn ess_player_data(source: &CommandSourceStackHc) -> EssentialsPlayerDataHc {
    let player = source.getPlayer();
    if player == null { return null; }
    let opt = player.getCapability(EssentialsCapabilityProviderHc::PLAYER_ESSENTIALS);
    let data = opt.orElse(null);
    if data == null { return null; }
    return data as EssentialsPlayerDataHc;
}

fn ess_home_limit(data: &EssentialsPlayerDataHc) -> Int {
    let override_limit = data.getHomeLimitOverride();
    if override_limit >= 0 { return override_limit; }
    return EssentialsServerConfigHc::HOMES_PER_PLAYER.get() as Int;
}

fn hc_teleport_home2(source: CommandSourceStackHc, name: String) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    let data = ess_player_data(&source);
    if data == null { return 0; }
    let home = data.getHome(name);
    if home == null {
        source.sendFailure(Component::literal("No home named \"{name}\" - set one with /hcsethome {name}") as Component);
        return 0;
    }
    TeleportExecutorHc::request(player, home, "home", "home \"{name}\"");
    return 1;
}

fn hc_set_home2(source: CommandSourceStackHc, name: String) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    let data = ess_player_data(&source);
    if data == null { return 0; }
    let limit = ess_home_limit(&data);
    if data.getHome(name) == null && EssentialsHcServerBridgeHc::homeCount(&data) >= limit {
        source.sendFailure(Component::literal("You've reached your limit of {limit} homes - delete one with /hcdelhome first.") as Component);
        return 0;
    }
    data.setHome(name, NamedLocationHc::of(player));
    source.sendSuccess(|| { return Component::literal("Home \"{name}\" set.") as JObjectCmd; }, false);
    return 1;
}

fn hc_delete_home2(source: CommandSourceStackHc, name: String) -> Int {
    let data = ess_player_data(&source);
    if data == null { return 0; }
    if !data.deleteHome(name) {
        source.sendFailure(Component::literal("No home named \"{name}\".") as Component);
        return 0;
    }
    source.sendSuccess(|| { return Component::literal("Home \"{name}\" deleted.") as JObjectCmd; }, false);
    return 1;
}

fn hc_list_homes2(source: CommandSourceStackHc) -> Int {
    let data = ess_player_data(&source);
    if data == null { return 0; }
    let csv = EssentialsHcServerBridgeHc::homeNamesCsv(&data);
    let count = EssentialsHcServerBridgeHc::homeCount(&data);
    if count == 0 {
        source.sendSuccess(|| { return Component::literal("You have no homes set. Use /hcsethome <name>.") as JObjectCmd; }, false);
    } else {
        let limit = ess_home_limit(&data);
        source.sendSuccess(|| { return Component::literal("Homes ({count}/{limit}): {csv}") as JObjectCmd; }, false);
    }
    return 1;
}

fn hc_suggest_home_names(ctx: CommandContextSrc, builder: SuggestionsBuilderHc) -> JObjectSuggestFuture {
    let source = ctx.getSource() as CommandSourceStackHc;
    let data = ess_player_data(&source);
    if data == null { return builder.buildFuture(); }
    let csv = EssentialsHcServerBridgeHc::homeNamesCsv(&data);
    return ess_suggest_from_csv(builder, csv).buildFuture();
}

pub fn register_real_home_commands(dispatcher: CommandDispatcherSrc) {
    let home_name_arg = CommandsHc::argument("name", StringArgumentTypeSrc::word() as ArgumentTypeSrc)
        .suggests(|ctx, builder| { return hc_suggest_home_names(ctx, builder); })
        .executes(|ctx| {
        return hc_teleport_home2(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "name"));
    });
    let home_builder = ess_literal("home", "hchome", "HOME")
        .executes(|ctx| { return hc_teleport_home2(ctx.getSource() as CommandSourceStackHc, "home"); })
        .then(home_name_arg);
    dispatcher.register(home_builder as LiteralArgumentBuilderSrc);

    let sethome_name_arg = CommandsHc::argument("name", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_set_home2(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "name"));
    });
    let sethome_builder = ess_literal("sethome", "hcsethome", "SETHOME")
        .executes(|ctx| { return hc_set_home2(ctx.getSource() as CommandSourceStackHc, "home"); })
        .then(sethome_name_arg);
    dispatcher.register(sethome_builder as LiteralArgumentBuilderSrc);

    let delhome_name_arg = CommandsHc::argument("name", StringArgumentTypeSrc::word() as ArgumentTypeSrc)
        .suggests(|ctx, builder| { return hc_suggest_home_names(ctx, builder); })
        .executes(|ctx| {
        return hc_delete_home2(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "name"));
    });
    let delhome_builder = ess_literal("delhome", "hcdelhome", "DELHOME").then(delhome_name_arg);
    dispatcher.register(delhome_builder as LiteralArgumentBuilderSrc);

    let homes_builder = ess_literal("homes", "hchomes", "HOMES").executes(|ctx| {
        return hc_list_homes2(ctx.getSource() as CommandSourceStackHc);
    });
    dispatcher.register(homes_builder as LiteralArgumentBuilderSrc);
}
