

fn hc_tpa_request(source: CommandSourceStackHc, target_name: String, here: Bool) -> Int {
    let requester = source.getPlayer();
    if requester == null { return 0; }
    let target = source.getServer().getPlayerList().getPlayerByName(target_name);
    if target == null {
        source.sendFailure(Component::literal("Player \"{target_name}\" isn't online.") as Component);
        return 0;
    }
    let error = EssentialsHcServerBridgeHc::tpaRequest(requester, target, here);
    if error != null {
        source.sendFailure(Component::literal(error) as Component);
        return 0;
    }
    return 1;
}

fn hc_tpa_respond(source: CommandSourceStackHc, accept: Bool) -> Int {
    let target = source.getPlayer();
    if target == null { return 0; }
    let error = EssentialsHcServerBridgeHc::tpaRespond(source.getServer(), target, accept);
    if error != null {
        source.sendFailure(Component::literal(error) as Component);
        return 0;
    }
    return 1;
}

fn hc_tpa_cancel(source: CommandSourceStackHc) -> Int {
    let requester = source.getPlayer();
    if requester == null { return 0; }
    let error = EssentialsHcServerBridgeHc::tpaCancel(requester);
    if error != null {
        source.sendFailure(Component::literal(error) as Component);
        return 0;
    }
    return 1;
}

pub fn register_real_tpa_commands(dispatcher: CommandDispatcherSrc) {
    let tpa_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_tpa_request(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"), false);
    });
    let tpa_builder = ess_literal("tpa", "hctpa", "TPA").then(tpa_arg);
    dispatcher.register(tpa_builder as LiteralArgumentBuilderSrc);

    let tpahere_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_tpa_request(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"), true);
    });
    let tpahere_builder = ess_literal("tpahere", "hctpahere", "TPA").then(tpahere_arg);
    dispatcher.register(tpahere_builder as LiteralArgumentBuilderSrc);

    let accept_builder = ess_literal("tpaccept", "hctpaccept", "TPA").executes(|ctx| {
        return hc_tpa_respond(ctx.getSource() as CommandSourceStackHc, true);
    });
    dispatcher.register(accept_builder as LiteralArgumentBuilderSrc);

    let deny_builder = ess_literal("tpdeny", "hctpdeny", "TPA").executes(|ctx| {
        return hc_tpa_respond(ctx.getSource() as CommandSourceStackHc, false);
    });
    dispatcher.register(deny_builder as LiteralArgumentBuilderSrc);

    let cancel_builder = ess_literal("tpcancel", "hctpcancel", "TPA").executes(|ctx| {
        return hc_tpa_cancel(ctx.getSource() as CommandSourceStackHc);
    });
    dispatcher.register(cancel_builder as LiteralArgumentBuilderSrc);
}
