    static fn persist();
    static fn rawCsvFor(category: Int, season: Bool, limit: Int) -> String;
    static fn rawCsvForTeams(category: Int, season: Bool, limit: Int) -> String;
    static fn seasonDaysConfigured() -> Int;
    static fn seasonDaysLeft() -> Long;
    static fn maybeRollover(server: MinecraftServerHc);
    static fn isCategoryAvailable(category: Int) -> Bool;
    static fn teamSupportAvailable() -> Bool;
    static fn availableCategoriesCsv() -> String;
    static fn rawCsvForCustomStat(stat_id: String, limit: Int) -> String;
}

