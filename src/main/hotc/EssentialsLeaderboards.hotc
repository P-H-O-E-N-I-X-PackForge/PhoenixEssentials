fn lb_capitalize_word(word: String) -> String {
    if word.length() == 0 { return word; }
    let cp = word.codePointAt(0);
    var upper_cp = cp;
    if cp >= 97 && cp <= 122 { upper_cp = cp - 32; }
    let first = DrChar::toString(upper_cp);
    let rest = word.substring(1, word.length());
    return "{first}{rest}";
}

pub fn lb_custom_stat_label(stat_id: String) -> String {
    let parts = stat_id.split(":");
    var path = parts[0];
    if parts.length > 1 { path = parts[1]; }
    let words = path.split("_");
    var out = "";
    var i = 0;
    while i < words.length {
        if i > 0 { out = "{out} "; }
        out = "{out}{lb_capitalize_word(words[i])}";
        i = i + 1;
    }
    return out;
}

pub fn lb_custom_rows(stat_id: String, limit: Int) -> [LbDisplayRow] {
    let raw = LbMgrHc::rawCsvForCustomStat(stat_id, limit);
    return lb_parse_raw(raw);
}

pub static lb_category_count: Int = 11;
pub static lb_category_playtime: Int = 0;
pub static lb_category_kills: Int = 1;
pub static lb_category_deaths: Int = 2;
pub static lb_category_mined: Int = 3;
pub static lb_category_distance: Int = 4;
pub static lb_category_animals_bred: Int = 5;
pub static lb_category_fish_caught: Int = 6;
pub static lb_category_items_enchanted: Int = 7;
pub static lb_category_raid_wins: Int = 8;
pub static lb_category_jumps: Int = 9;
pub static lb_category_quests: Int = 10;

pub fn lb_category_label(category: Int) -> String {
    if category == lb_category_playtime { return "Playtime"; }
    if category == lb_category_kills { return "Mob Kills"; }
    if category == lb_category_deaths { return "Deaths"; }
    if category == lb_category_mined { return "Blocks Mined"; }
    if category == lb_category_distance { return "Distance Traveled"; }
    if category == lb_category_animals_bred { return "Animals Bred"; }
    if category == lb_category_fish_caught { return "Fish Caught"; }
    if category == lb_category_items_enchanted { return "Items Enchanted"; }
    if category == lb_category_raid_wins { return "Raids Won"; }
    if category == lb_category_jumps { return "Jumps"; }
    return "Quests Completed";
}

pub fn lb_category_short_label(category: Int) -> String {
    if category == lb_category_playtime { return "Time"; }
    if category == lb_category_kills { return "Kills"; }
    if category == lb_category_deaths { return "Deaths"; }
    if category == lb_category_mined { return "Mined"; }
    if category == lb_category_distance { return "Dist"; }
    if category == lb_category_animals_bred { return "Breeding"; }
    if category == lb_category_fish_caught { return "Fishing"; }
    if category == lb_category_items_enchanted { return "Enchants"; }
    if category == lb_category_raid_wins { return "Raids"; }
    if category == lb_category_jumps { return "Jumps"; }
    return "Quests";
}

pub fn lb_category_from_name(name: String) -> Int {
    let n = name.toLowerCase();
    if n == "playtime" || n == "time" { return lb_category_playtime; }
    if n == "kills" || n == "kill" || n == "mobkills" { return lb_category_kills; }
    if n == "deaths" || n == "death" { return lb_category_deaths; }
    if n == "mined" || n == "blocks" || n == "blocksmined" { return lb_category_mined; }
    if n == "distance" || n == "dist" || n == "traveled" { return lb_category_distance; }
    if n == "animalsbred" || n == "animals" || n == "breeding" || n == "bred" { return lb_category_animals_bred; }
    if n == "fishcaught" || n == "fish" || n == "fishing" { return lb_category_fish_caught; }
    if n == "itemsenchanted" || n == "enchants" || n == "enchanted" || n == "enchanting" { return lb_category_items_enchanted; }
    if n == "raidwins" || n == "raids" || n == "raid" { return lb_category_raid_wins; }
    if n == "jumps" || n == "jump" { return lb_category_jumps; }
    if n == "quests" || n == "questscompleted" || n == "quest" { return lb_category_quests; }
    return -1;
}

pub fn lb_format_value(category: Int, value: Long) -> String {
    if category == lb_category_playtime {
        let hours = value / 3600L;
        let minutes = (value % 3600L) / 60L;
        let seconds = value % 60L;
        if hours > 0L { return "{hours}h {minutes}m"; }
        if minutes > 0L { return "{minutes}m {seconds}s"; }
        return "{seconds}s";
    }
    if category == lb_category_distance { return "{value} blocks"; }
    return "{value}";
}

struct LbDisplayRow {
    name: String,
    value: String,
    crowns: Int,
}

fn lb_parse_raw(raw: String) -> [LbDisplayRow] {
    if raw.length() == 0 { return [LbDisplayRow { name: "", value: "", crowns: 0 }; 0]; }
    let parts = raw.split(",");
    var out = [LbDisplayRow { name: "", value: "", crowns: 0 }; parts.length];
    var i = 0;
    while i < parts.length {
        let f = parts[i].split(":");
        out[i] = LbDisplayRow { name: f[0], value: f[1], crowns: DrInt::parseInt(f[2], 10) };
        i = i + 1;
    }
    return out;
}

pub fn lb_rows(category: Int, season: Bool, limit: Int) -> [LbDisplayRow] {
    let raw = LbMgrHc::rawCsvFor(category, season, limit);
    return lb_parse_raw(raw);
}

pub fn lb_team_rows(category: Int, season: Bool, limit: Int) -> [LbDisplayRow] {
    let raw = LbMgrHc::rawCsvForTeams(category, season, limit);
    return lb_parse_raw(raw);
}

pub fn lb_display_csv(category: Int, season: Bool, team: Bool, limit: Int) -> String {
    var rows = lb_rows(category, season, limit);
    if team { rows = lb_team_rows(category, season, limit); }
    var out = "";
    var i = 0;
    while i < rows.length {
        if i > 0 { out = "{out},"; }
        let num = DrLong::parseLong(rows[i].value, 10);
        let disp = lb_format_value(category, num);
        out = "{out}{rows[i].name}:{disp}:{rows[i].crowns}";
        i = i + 1;
    }
    return out;
}

fn lb_print_board(source: CommandSourceStackHc, category: Int, team: Bool) -> Int {
    var rows = lb_rows(category, false, 10);
    if team { rows = lb_team_rows(category, false, 10); }
    let label = lb_category_label(category);
    if rows.length == 0 {
        source.sendSuccess(|| { return Component::literal("§7No {label} leaderboard data yet.") as JObjectCmd; }, false);
        return 1;
    }
    var header = "§6--- {label} leaderboard ---";
    if team { header = "§6--- {label} leaderboard (teams) ---"; }
    source.sendSuccess(|| { return Component::literal(header) as JObjectCmd; }, false);
    var i = 0;
    while i < rows.length {
        let row = rows[i];
        let rank = i + 1;
        let num = DrLong::parseLong(row.value, 10);
        let disp = lb_format_value(category, num);
        var suffix = "";
        if team {
            suffix = " §8({row.crowns} members)";
        } else {
            if row.crowns > 0 { suffix = " §6(x{row.crowns})"; }
        }
        let line = "§7#{rank} §f{row.name} §8- §a{disp}{suffix}";
        source.sendSuccess(|| { return Component::literal(line) as JObjectCmd; }, false);
        i = i + 1;
    }
    return 1;
}

fn lb_command_default(source: CommandSourceStackHc) -> Int {
    return lb_print_board(source, lb_category_playtime, false);
}

fn lb_resolve_category(source: &CommandSourceStackHc, category_name: String) -> Int {
    let category = lb_category_from_name(category_name);
    if category < 0 {
        source.sendFailure(Component::literal("Unknown leaderboard \"{category_name}\". Try: playtime, kills, deaths, mined, distance, animalsbred, fish, enchants, raids, jumps, quests.") as Component);
        return -1;
    }
    if !LbMgrHc::isCategoryAvailable(category) {
        let label = lb_category_label(category);
        source.sendFailure(Component::literal("The {label} leaderboard isn't available on this server (its mod isn't installed).") as Component);
        return -1;
    }
    return category;
}

fn lb_command_named(source: CommandSourceStackHc, category_name: String) -> Int {
    let category = lb_resolve_category(&source, category_name);
    if category < 0 { return 0; }
    return lb_print_board(source, category, false);
}

fn lb_command_named_team(source: CommandSourceStackHc, category_name: String) -> Int {
    if !LbMgrHc::teamSupportAvailable() {
        source.sendFailure(Component::literal("Team leaderboards aren't available on this server (no FTB Teams or Phoenix Guilds backend is loaded).") as Component);
        return 0;
    }
    let category = lb_resolve_category(&source, category_name);
    if category < 0 { return 0; }
    return lb_print_board(source, category, true);
}

fn lb_register_pair(dispatcher: &CommandDispatcherSrc, real_name: String, twin_name: String) {
    let team_literal = CommandsHc::literal("team").executes(|ctx| {
        return lb_command_named_team(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "category"));
    });
    let category_arg = CommandsHc::argument("category", StringArgumentTypeSrc::word() as ArgumentTypeSrc)
        .executes(|ctx| {
            return lb_command_named(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "category"));
        })
        .then(team_literal);
    let builder = ess_literal(real_name, twin_name, "LEADERBOARDS")
        .executes(|ctx| { return lb_command_default(ctx.getSource() as CommandSourceStackHc); })
        .then(category_arg);
    dispatcher.register(builder as LiteralArgumentBuilderSrc);
}

pub fn register_real_leaderboards_command(dispatcher: CommandDispatcherSrc) {
    lb_register_pair(&dispatcher, "leaderboards", "hcleaderboards");
    lb_register_pair(&dispatcher, "lb", "hclb");
}
