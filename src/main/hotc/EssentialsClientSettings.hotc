

extern class EssentialsHcDataRootHc = "net.phoenixvine.essentials.EssentialsHcData" {
    static fn readRootFile(name: String) -> String?;
    static fn writeRootFile(name: String, content: String);
}

static cs_show_afk: Bool = true;
static cs_loaded: Bool = false;

pub fn dr_settings_load() {
    cs_loaded = true;
    cs_show_afk = true;
    let raw = EssentialsHcDataRootHc::readRootFile("phoenix_essentials_settings.json");
    if raw != null {
        js_parse(raw);
        var i = 0;
        while i < js_cells.length {
            let cell = js_cells[i];
            if cell.entry == "" && cell.name == "showAfkOverlay" {
                cs_show_afk = cell.value == "true";
            }
            i = i + 1;
        }
    }
}

pub fn dr_settings_show_afk() -> Int {
    if !cs_loaded { dr_settings_load(); }
    if cs_show_afk { return 1; }
    return 0;
}

pub fn dr_settings_set_show_afk(v: Int) {
    if !cs_loaded { dr_settings_load(); }
    cs_show_afk = v != 0;
}

pub fn dr_settings_save() {
    let q = js_q();
    let lb = js_lb();
    let rb = js_rb();
    var v = "false";
    if cs_show_afk { v = "true"; }
    EssentialsHcDataRootHc::writeRootFile("phoenix_essentials_settings.json", "{lb}\n  {q}showAfkOverlay{q}: {v}\n{rb}");
}

pub fn sb_next_gamemode(current: String) -> String {
    if current == "survival" { return "creative"; }
    if current == "creative" { return "adventure"; }
    if current == "adventure" { return "spectator"; }
    return "survival";
}

pub fn sb_next_weather_state(cur: Int, seed: Int) -> Int {
    var s = cur;
    if s == -1 { s = seed; }
    return (s + 1) % 3;
}

pub fn sb_weather_command(cur: Int) -> String {
    if cur == 1 { return "weather rain"; }
    if cur == 2 { return "weather thunder"; }
    return "weather clear";
}

pub fn sb_next_time(day_time: Long, has_level: Int) -> String {
    if has_level == 0 { return "day"; }
    let tod = day_time % 24000L;
    if tod < 1000L { return "noon"; }
    if tod < 6000L { return "night"; }
    if tod < 13000L { return "midnight"; }
    return "day";
}
