// --- Real port of SeenCommand.java ---
//
// Same "call the real Java directly" approach every other ported command uses --
// `EssentialsHcServerBridgeHc::seenMessage` is a direct copy of the original's own online/offline
// lookup (`OfflinePlayerIndex`, the server profile cache) and elapsed-time formatting, returned as
// one plain string (or `null` for "no record") instead of binding `GameProfileCache`/`Optional`/
// `UUID`/`OfflinePlayerIndex.Entry`'s public fields individually for one real caller.
// `hc`-prefixed literal, same side-by-side-pilot reasoning; the real `/seen` stays registered.

fn hc_seen(source: CommandSourceStackHc, name: String) -> Int {
    let message = EssentialsHcServerBridgeHc::seenMessage(source.getServer(), name);
    if message == null {
        source.sendFailure(Component::literal("No record of a player named \"{name}\".") as Component);
        return 0;
    }
    source.sendSuccess(|| { return Component::literal(message) as JObjectCmd; }, false);
    return 1;
}

pub fn register_real_seen_command(dispatcher: CommandDispatcherSrc) {
    let player_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_seen(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"));
    });
    let seen_builder = ess_literal("seen", "hcseen", "SEEN").then(player_arg);
    dispatcher.register(seen_builder as LiteralArgumentBuilderSrc);
}
