// --- HC port of the client-side entry points ---
//
// Replaces the client halves of `EssentialsClientProxy` (the FMLClientSetupEvent handler: theme
// registration + the five suite-bar buttons), `EssentialsKeyBindings` (key-mapping registration),
// `EssentialsHcClient` (the second menu key + its tick handler) and `EssentialsInputHandler` (the
// open-menu key tick handler). `client_construct()` registers all their listeners; the Java
// `EssentialsClientProxy.registerConfigScreen` (reached through the client-only `DistExecutor` hop from
// the mod constructor) calls it, so none of this is ever touched on a dedicated server.
//
// The two `KeyMapping` objects stay Java statics (`EssentialsKeyBindings.OPEN_MENU` / `OPEN_MENU_HC`):
// creating one at class-load is a client-only side effect, and the Java config screen reads
// `OPEN_MENU` directly. HC reads them via GETSTATIC.
//
// Key behavior is unchanged: Y opens the HC config screen (the original Java screen with
// `-Dphoenix_essentials.use_java=true`); H opens the OTHER one for side-by-side comparison. While a
// screen is open (or there is no player) a Y press is swallowed, like before.
// The suite-bar settings button still opens the ORIGINAL Java screen with the current screen as its
// parent, exactly as the Java did.

extern class CeKeyMapping = "net.minecraft.client.KeyMapping" {
    fn consumeClick(&self) -> Bool;
    fn matches(&self, key: Int, scan: Int) -> Bool;
}

extern class CeKeys = "net.phoenixvine.essentials.client.EssentialsKeyBindings" {
    static OPEN_MENU: CeKeyMapping;
    static OPEN_MENU_HC: CeKeyMapping;
}

extern class CeRegisterKeysEvent = "net.minecraftforge.client.event.RegisterKeyMappingsEvent" {
    fn register(&self, key: CeKeyMapping);
}

extern class CeMinecraft = "net.minecraft.client.Minecraft" {
    static fn getInstance() -> CeMinecraft;
    fn setScreen(&self, screen: ScreenHc);
    player: LocalPlayer;
    screen: ScreenHc;
}

extern class CeClientTickEvent = "net.minecraftforge.event.TickEvent$ClientTickEvent" {
    phase: TickPhaseHc;
}

// The original Java config screen (the side-by-side fallback / the suite-bar settings button).
extern class CeJavaConfigScreen = "net.phoenixvine.essentials.client.EssentialsConfigScreen" {
    fn new(parent: ScreenHc) -> Self;
}

extern class CePhoenixTheme = "net.phoenixvine.wiki.theme.PhoenixTheme" {
    static fn registerMod(pkg: String, modid: String);
}

// SuiteHudBar.register has three overloads; extern methods resolve by their DECLARED signature, so each
// overload gets its own alias of the same class.
extern class CeSuiteBarSimple = "net.phoenixvine.wiki.client.suite.SuiteHudBar" {
    static PRIORITY_ESSENTIALS: Int;
    static fn register(id: String, priority: Int, icon: ResourceLocation, tooltip: Component, action: &dyn JRunnableNet);
}
extern class CeSuiteBarFull = "net.phoenixvine.wiki.client.suite.SuiteHudBar" {
    static fn register(id: String, priority: Int, icon: ResourceLocation, tooltip: &dyn CeSupplier, visible: &dyn CeIntSupplier, action: &dyn JRunnableNet, w: Int, h: Int, flag: Bool);
}
extern interface CeSupplier = "java.util.function.Supplier" {
    fn get(&self) -> JObjectCmd;
}
extern interface CeIntSupplier = "java.util.function.IntSupplier" {
    fn getAsInt(&self) -> Int;
}

// Java helpers on the suite-bar facade (they read live client state / send the command).
extern class CeSuiteBarJava = "net.phoenixvine.essentials.client.EssentialsSuiteBarButton" {
    static fn isLocalPlayerOp() -> Bool;
    static fn gamemodeCommand();
    static fn cycleWeatherNow();
    static fn timeCommand();
}

extern class CeMode = "net.phoenixvine.essentials.EssentialsHcMode" {
    static fn takeover() -> Bool;
}
extern class CeLog = "net.phoenixvine.essentials.EssentialsHcData" {
    static fn logInfo(msg: String);
}

fn ce_icon(path: String) -> ResourceLocation {
    return ResourceLocation::new("phoenix_essentials", path);
}

fn ce_op_visible() -> Int {
    if CeSuiteBarJava::isLocalPlayerOp() { return 1; }
    return 0;
}

fn ce_register_keys(e: JObjectEvent) {
    let ev = e as CeRegisterKeysEvent;
    ev.register(CeKeys::OPEN_MENU);
    ev.register(CeKeys::OPEN_MENU_HC);
}

fn ce_client_setup(e: JObjectEvent) {
    CeLog::logInfo("[Phoenix Essentials] Client setup complete.");

    // Lets the suite's shared/per-mod theme toggle tell this mod's own code apart from every other
    // Phoenix mod's when they call the no-arg theme accessors.
    CePhoenixTheme::registerMod("net.phoenixvine.essentials", "phoenix_essentials");

    CeSuiteBarSimple::register("phoenix_essentials.settings", CeSuiteBarSimple::PRIORITY_ESSENTIALS,
        ce_icon("textures/gui/suite_bar_icon.png"),
        Component::literal("§fOpen Essentials Menu") as Component,
        || {
            let mc = CeMinecraft::getInstance();
            mc.setScreen(CeJavaConfigScreen::new(mc.screen) as ScreenHc);
        });

    CeSuiteBarFull::register("phoenix_essentials.trash", CeSuiteBarSimple::PRIORITY_ESSENTIALS + 1,
        ce_icon("textures/gui/trash_icon.png"),
        || { return Component::literal("§fOpen Trash") as JObjectCmd; },
        || { return 1; },
        || { CeMinecraft::getInstance().player.connection.sendCommand("essentialstrash"); },
        16, 16, true);

    CeSuiteBarFull::register("phoenix_essentials.gamemode", CeSuiteBarSimple::PRIORITY_ESSENTIALS + 2,
        ce_icon("textures/gui/gamemode_icon.png"),
        || { return Component::literal("§fSwitch Gamemode") as JObjectCmd; },
        || { return ce_op_visible(); },
        || { CeSuiteBarJava::gamemodeCommand(); },
        16, 16, true);

    CeSuiteBarFull::register("phoenix_essentials.weather", CeSuiteBarSimple::PRIORITY_ESSENTIALS + 3,
        ce_icon("textures/gui/weather_icon.png"),
        || { return Component::literal("§fSwitch Weather") as JObjectCmd; },
        || { return ce_op_visible(); },
        || { CeSuiteBarJava::cycleWeatherNow(); },
        16, 16, true);

    CeSuiteBarFull::register("phoenix_essentials.time", CeSuiteBarSimple::PRIORITY_ESSENTIALS + 4,
        ce_icon("textures/gui/time_icon.png"),
        || { return Component::literal("§fSwitch Time of Day") as JObjectCmd; },
        || { return ce_op_visible(); },
        || { CeSuiteBarJava::timeCommand(); },
        16, 16, true);
}

// Both keys, one tick handler (the Java had two handlers with these exact semantics).
fn ce_client_tick(e: JObjectEvent) {
    let ev = e as CeClientTickEvent;
    if ev.phase != TickPhaseHc::END { return; }
    let mc = CeMinecraft::getInstance();

    // Y -- the main open-menu key.
    if mc.player == null || mc.screen != null {
        CeKeys::OPEN_MENU.consumeClick();
    } else {
        if CeKeys::OPEN_MENU.consumeClick() {
            if CeMode::takeover() {
                open_essentials_config_screen_hc();
            } else {
                mc.setScreen(CeJavaConfigScreen::new(null as ScreenHc) as ScreenHc);
            }
        }
    }

    // H -- the other implementation, for side-by-side comparison.
    while CeKeys::OPEN_MENU_HC.consumeClick() {
        if CeMode::takeover() {
            mc.setScreen(CeJavaConfigScreen::new(null as ScreenHc) as ScreenHc);
        } else {
            open_essentials_config_screen_hc();
        }
    }
}

// The HC config screen asks this whether a pressed key is the open-menu key (closing the screen on it).
pub fn ce_is_open_menu_key(key: Int, scan: Int) -> Bool {
    return CeKeys::OPEN_MENU.matches(key, scan);
}

// Called (client only) from `EssentialsClientProxy.registerConfigScreen` during mod construction.
pub fn client_construct() {
    let mod_bus = MeModBusContext::get().getModEventBus();
    mod_bus.addListener(EventPriorityHc::NORMAL, false,
        class("net.minecraftforge.fml.event.lifecycle.FMLClientSetupEvent") as JClassNet,
        |e| { ce_client_setup(e); });
    mod_bus.addListener(EventPriorityHc::NORMAL, false,
        class("net.minecraftforge.client.event.RegisterKeyMappingsEvent") as JClassNet,
        |e| { ce_register_keys(e); });
    MinecraftForgeHc::EVENT_BUS.addListener(EventPriorityHc::NORMAL, false,
        class("net.minecraftforge.event.TickEvent$ClientTickEvent") as JClassNet,
        |e| { ce_client_tick(e); });
}
