

static ess_cache_homes: [String] = [""; 0];
static ess_cache_homes_cap: Int = 0;
static ess_cache_warps: [String] = [""; 0];
static ess_cache_kit_names: [String] = [""; 0];
static ess_cache_kit_secs: [Int] = [0; 0];
static ess_cache_trash: [String] = [""; 0];

fn ess_split_csv(csv: String) -> [String] {
    if csv.length() > 0 { return csv.split(","); }
    return [""; 0];
}

fn ess_cache_set_homes(csv: String, cap: Int) {
    let names = ess_split_csv(csv);
    ess_cache_homes_cap = cap;
    ess_cache_homes = names;
}

fn ess_cache_set_warps(csv: String) {
    let names = ess_split_csv(csv);
    ess_cache_warps = names;
}

fn ess_cache_set_trash(csv: String) {
    let ids = ess_split_csv(csv);
    ess_cache_trash = ids;
}

fn ess_cache_set_kits(csv: String) {
    let pairs = ess_split_csv(csv);
    var names = [""; pairs.length];
    var secs = [0; pairs.length];
    var i = 0;
    while i < pairs.length {
        let parts = pairs[i].split(":");
        names[i] = parts[0];
        secs[i] = JIntNet::parseInt(parts[1]);
        i = i + 1;
    }
    ess_cache_kit_secs = secs;
    ess_cache_kit_names = names;
}

extern class JIntNet = "java.lang.Integer" {
    static fn parseInt(s: String) -> Int;
}

struct RequestSyncPacket { kind: Int }
struct GuiTeleportPacket { kind: Int, name: String }
struct GuiClaimKitPacket { name: String }
struct HomesSyncPacket { csv: String, cap: Int }
struct WarpsSyncPacket { csv: String }
struct KitsSyncPacket { csv: String }
struct AutoTrashSyncPacket { csv: String }

impl RequestSyncPacket {
    fn encode(&self, buf: FriendlyByteBuf) { buf.writeVarInt(self.kind); }
    static fn decode(buf: FriendlyByteBuf) -> RequestSyncPacket { return RequestSyncPacket { kind: buf.readVarInt() }; }
    fn on_received(&self, sender: ServerPlayer) { ess_handle_request_sync(sender, self.kind); }
}

impl GuiTeleportPacket {
    fn encode(&self, buf: FriendlyByteBuf) { buf.writeVarInt(self.kind).writeUtf(self.name); }
    static fn decode(buf: FriendlyByteBuf) -> GuiTeleportPacket {
        let kind = buf.readVarInt();
        let name = buf.readUtf();
        return GuiTeleportPacket { kind: kind, name: name };
    }
    fn on_received(&self, sender: ServerPlayer) { ess_handle_gui_teleport(sender, self.kind, self.name); }
}

impl GuiClaimKitPacket {
    fn encode(&self, buf: FriendlyByteBuf) { buf.writeUtf(self.name); }
    static fn decode(buf: FriendlyByteBuf) -> GuiClaimKitPacket { return GuiClaimKitPacket { name: buf.readUtf() }; }
    fn on_received(&self, sender: ServerPlayer) { ess_handle_claim_kit(sender, self.name); }
}

impl HomesSyncPacket {
    fn encode(&self, buf: FriendlyByteBuf) { buf.writeUtf(self.csv).writeVarInt(self.cap); }
    static fn decode(buf: FriendlyByteBuf) -> HomesSyncPacket {
        let csv = buf.readUtf();
        let cap = buf.readVarInt();
        return HomesSyncPacket { csv: csv, cap: cap };
    }
    fn on_received(&self) { ess_cache_set_homes(self.csv, self.cap); }
}

impl WarpsSyncPacket {
    fn encode(&self, buf: FriendlyByteBuf) { buf.writeUtf(self.csv); }
    static fn decode(buf: FriendlyByteBuf) -> WarpsSyncPacket { return WarpsSyncPacket { csv: buf.readUtf() }; }
    fn on_received(&self) { ess_cache_set_warps(self.csv); }
}

impl KitsSyncPacket {
    fn encode(&self, buf: FriendlyByteBuf) { buf.writeUtf(self.csv); }
    static fn decode(buf: FriendlyByteBuf) -> KitsSyncPacket { return KitsSyncPacket { csv: buf.readUtf() }; }
    fn on_received(&self) { ess_cache_set_kits(self.csv); }
}

impl AutoTrashSyncPacket {
    fn encode(&self, buf: FriendlyByteBuf) { buf.writeUtf(self.csv); }
    static fn decode(buf: FriendlyByteBuf) -> AutoTrashSyncPacket { return AutoTrashSyncPacket { csv: buf.readUtf() }; }
    fn on_received(&self) { ess_cache_set_trash(self.csv); }
}

fn ess_send_to_player(player: ServerPlayer, msg: PhoenixObject4Net) {
    let chan = ess_hc_channel;
    if chan == null { return; }
    let target = PacketDistributorHc::PLAYER.with(|| { return player as PhoenixObject4Net; });
    chan.send(target, msg);
}

fn ess_player_data_of(player: &ServerPlayer) -> EssentialsPlayerDataHc {
    let opt = player.getCapability(EssentialsCapabilityProviderHc::PLAYER_ESSENTIALS);
    let data_obj = opt.orElse(null);
    if data_obj == null { return null; }
    return data_obj as EssentialsPlayerDataHc;
}

fn ess_handle_request_sync(player: ServerPlayer, kind: Int) {
    if kind == 0 {
        var csv = "";
        let data = ess_player_data_of(&player);
        if data != null { csv = EssentialsHcServerBridgeHc::homeNamesCsv(&data); }
        ess_send_to_player(player, HomesSyncPacket { csv: csv, cap: EssentialsHcServerBridgeHc::homesPerPlayer() } as PhoenixObject4Net);
        return;
    }
    if kind == 1 {
        ess_send_to_player(player, WarpsSyncPacket { csv: EssentialsHcServerBridgeHc::warpNamesCsv() } as PhoenixObject4Net);
        return;
    }
    if kind == 2 {
        ess_send_to_player(player, KitsSyncPacket { csv: EssentialsHcServerBridgeHc::kitSyncCsv(player) } as PhoenixObject4Net);
        return;
    }
    var ids = "";
    let data = ess_player_data_of(&player);
    if data != null { ids = EssentialsHcServerBridgeHc::autoTrashCsv(&data); }
    ess_send_to_player(player, AutoTrashSyncPacket { csv: ids } as PhoenixObject4Net);
}

fn ess_handle_gui_teleport(player: ServerPlayer, kind: Int, name: String) {
    let data = ess_player_data_of(&player);
    if kind == 0 {
        if data == null { return; }
        let home = data.getHome(name);
        if home == null { return; }
        TeleportExecutorHc::request(player, home, "home", "home \"{name}\"");
        return;
    }
    if kind == 1 {
        let warp = WarpRegistryHc::get(name);
        if warp == null { return; }
        TeleportExecutorHc::request(player, warp, "warp", "warp \"{name}\"");
        return;
    }
    if data == null { return; }
    let back = data.getBack();
    if back == null {
        player.sendSystemMessage(Component::literal("You have nowhere to go back to.") as Component);
        return;
    }
    TeleportExecutorHc::request(player, back, "back", "your previous location");
}

fn ess_handle_claim_kit(player: ServerPlayer, name: String) {
    if !EssentialsHcModeHc::featureEnabled(&player, "kits") {
        player.sendSystemMessage(Component::literal("Kits aren't available here right now.") as Component);
        return;
    }
    if !EssentialsHcServerBridgeHc::kitExists(name) { return; }
    let data = ess_player_data_of(&player);
    if data == null { return; }
    let remaining = EssentialsHcServerBridgeHc::kitCooldownRemainingSeconds(&data, name);
    if remaining > 0 {
        player.sendSystemMessage(Component::literal("You can claim \"{name}\" again in {remaining}s.") as Component);
        return;
    }
    EssentialsHcServerBridgeHc::claimKit(player, &data, name);
    player.sendSystemMessage(Component::literal("Claimed kit \"{name}\".") as Component);
}

pub static ess_hc_channel: SimpleChannel? = null;

fn set_hc_channel(channel: SimpleChannel?) {
    ess_hc_channel = channel;
}

extern class EssentialsNetUnwrapHc = "net.phoenixvine.essentials.EssentialsHcServerBridge" {
    static fn unwrapSupplier(o: PhoenixObject4Net) -> PhoenixObject4Net;
}

fn ess_dir_server() -> JOptionalNet { return JOptionalNet::of(NetworkDirectionHc::PLAY_TO_SERVER as PhoenixObject4Net); }
fn ess_dir_client() -> JOptionalNet { return JOptionalNet::of(NetworkDirectionHc::PLAY_TO_CLIENT as PhoenixObject4Net); }

fn ess_reg_c2s_request(channel: &SimpleChannel, id: Int) {
    channel.registerMessage(id, class("RequestSyncPacket") as JClassNet,
        |pkt, buf| { (pkt as RequestSyncPacket).encode(buf as FriendlyByteBuf); },
        |buf| { return RequestSyncPacket::decode(buf as FriendlyByteBuf) as PhoenixObject4Net; },
        |pkt, ctx| {
            let real_ctx = EssentialsNetUnwrapHc::unwrapSupplier(ctx) as NetworkEventContextHc;
            let sender = real_ctx.getSender();
            let packet = pkt as RequestSyncPacket;
            real_ctx.enqueueWork(|| { packet.on_received(sender); });
        },
        ess_dir_server());
}

fn ess_reg_c2s_teleport(channel: &SimpleChannel, id: Int) {
    channel.registerMessage(id, class("GuiTeleportPacket") as JClassNet,
        |pkt, buf| { (pkt as GuiTeleportPacket).encode(buf as FriendlyByteBuf); },
        |buf| { return GuiTeleportPacket::decode(buf as FriendlyByteBuf) as PhoenixObject4Net; },
        |pkt, ctx| {
            let real_ctx = EssentialsNetUnwrapHc::unwrapSupplier(ctx) as NetworkEventContextHc;
            let sender = real_ctx.getSender();
            let packet = pkt as GuiTeleportPacket;
            real_ctx.enqueueWork(|| { packet.on_received(sender); });
        },
        ess_dir_server());
}

