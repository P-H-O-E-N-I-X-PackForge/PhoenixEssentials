pub fn setup_hc_networking() {
    let channel = NetworkRegistry::newSimpleChannel(
        ResourceLocation::new("phoenix_essentials", "main_hc"),
        || { return "1" as PhoenixObject4Net; },
        |v| { return true; },
        |v| { return true; }
    );
    register_afk_packet(channel, 0);
    ess_reg_c2s_request(channel, 1);
    ess_reg_c2s_teleport(channel, 2);
    ess_reg_c2s_claim(channel, 3);
    ess_reg_s2c_homes(channel, 4);
    ess_reg_s2c_warps(channel, 5);
    ess_reg_s2c_kits(channel, 6);
    ess_reg_s2c_trash(channel, 7);
    set_hc_channel(channel);
}

pub fn ess_send_request_sync(kind: Int) {
    let chan = ess_hc_channel;
    if chan == null { return; }
    chan.sendToServer(RequestSyncPacket { kind: kind } as PhoenixObject4Net);
}

pub fn ess_send_gui_teleport(kind: Int, name: String) {
    let chan = ess_hc_channel;
    if chan == null { return; }
    chan.sendToServer(GuiTeleportPacket { kind: kind, name: name } as PhoenixObject4Net);
}

pub fn ess_send_claim_kit(name: String) {
    let chan = ess_hc_channel;
    if chan == null { return; }
    chan.sendToServer(GuiClaimKitPacket { name: name } as PhoenixObject4Net);
}
