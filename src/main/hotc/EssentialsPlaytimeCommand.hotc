// --- Real port of PlaytimeCommand.java ---
//
// Same "call the real Java directly" approach every other ported command in this project uses.
// `/hcplaytime [player]` reads the real `PlayerEssentialsData.getPlaytimeTicks()` (via
// `EssentialsHcServerBridgeHc::playtimeFormatted`, a direct copy of the original's own `format()`
// so this port doesn't need a `java.lang.Long` binding for one real caller) for either the command
// sender or a named online player (`MinecraftServerHc::getPlayerList`/`PlayerListHc::
// getPlayerByName`, `command.hc`'s own new, previously-disclosed-gap binding -- first real closer
// of "a real player-by-name lookup, a separate, not-yet-bound surface").
//
// `hc`-prefixed command literal -- same side-by-side-pilot reasoning every other ported command
// file in this project already gives; the real `/playtime` (`PlaytimeCommand.java`) stays
// registered and untouched.

fn hc_playtime_for(source: CommandSourceStackHc, target: ServerPlayer) -> Int {
    let opt = target.getCapability(EssentialsCapabilityProviderHc::PLAYER_ESSENTIALS);
    let data_obj = opt.orElse(null);
    if data_obj == null { return 0; }
    let data = data_obj as EssentialsPlayerDataHc;
    let name = target.getGameProfile().getName();
    let formatted = EssentialsHcServerBridgeHc::playtimeFormatted(&data);
    source.sendSuccess(|| { return Component::literal("{name}'s playtime: {formatted}") as JObjectCmd; }, false);
    return 1;
}

fn hc_playtime_self(source: CommandSourceStackHc) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    return hc_playtime_for(source, player);
}

fn hc_playtime_named(source: CommandSourceStackHc, target_name: String) -> Int {
    let target = source.getServer().getPlayerList().getPlayerByName(target_name);
    if target == null {
        source.sendFailure(Component::literal("Player \"{target_name}\" isn't online.") as Component);
        return 0;
    }
    return hc_playtime_for(source, target);
}

pub fn register_real_playtime_command(dispatcher: CommandDispatcherSrc) {
    let player_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_playtime_named(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"));
    });
    let playtime_builder = CommandsHc::literal("hcplaytime")
        .executes(|ctx| { return hc_playtime_self(ctx.getSource() as CommandSourceStackHc); })
        .then(player_arg);
    dispatcher.register(playtime_builder as LiteralArgumentBuilderSrc);
}
