// --- Real, pixel-faithful port of EssentialsListScreen.java ---
//
// Same "call the real Java chrome/theme code directly" approach `EssentialsConfigScreenHc.hotc`
// already established -- `EssentialsUIKitHc::drawModalChrome`/`drawBorder` and
// `EssentialsThemePaletteHc`'s own real static color fields are called/read directly, so the
// output is pixel/color-identical to the original by construction. The data/network path is HC now
// too (`EssentialsNetworkPackets.hotc`): requests/teleports/kit claims go out on the HC channel and
// the lists come back into HC-side cache statics this screen reads -- nothing here touches the
// Java `EssentialsNetwork`/`EssentialsClientCache` any more.
//
// Real, disclosed simplifications versus the original (both cosmetic, not behavioral):
// 1. The original caches its own built row list and only rebuilds when the underlying cache
//    object's REFERENCE changes, plus throttles a Kits rebuild to once per 500ms. This port just
//    rebuilds the row list fresh every `render()` call instead -- a few array reads and struct
//    literals per frame, no observable behavior difference.
// 2. The original shows "Loading..." until the FIRST real sync reply changes the cache
//    (`hasSynced`). This port approximates it with a plain "has this screen rendered more than
//    once yet" flag -- the first frame shows "Loading...", every frame after shows the real
//    empty-state message.

struct EssListRow {
    label: String,
    action_name: String,
    clickable: Bool,
}

fn ess_list_row_h() -> Int { return 18; }
fn ess_list_panel_w() -> Int { return 260; }
fn ess_list_panel_h() -> Int { return 220; }

static ess_list_kind: Int = 0; // 0=homes 1=warps 2=kits 3=trash -- same values the HC sync packets use
static ess_list_title: String = "";
static ess_list_rendered_once: Bool = false;

pub static ess_list_kind_homes: Int = 0;
pub static ess_list_kind_warps: Int = 1;
pub static ess_list_kind_kits: Int = 2;
pub static ess_list_kind_trash: Int = 3;

fn ess_list_empty_message() -> String {
    if ess_list_kind == ess_list_kind_homes { return "§8No homes set"; }
    if ess_list_kind == ess_list_kind_warps { return "§8No warps available"; }
    if ess_list_kind == ess_list_kind_kits { return "§8No kits available"; }
    return "§8No items set to auto-trash";
}

// Real stand-in for `displayNameOf` -- `ResourceLocation::tryParse`/`ForgeRegistryItem::getValue`
// are both real, nullable lookups (`resource.hc`/`registry.hc`'s own new bindings); falls back to
// the raw id string exactly like the original does when either lookup misses.
fn ess_list_display_name_of(id: String) -> String {
    let loc = ResourceLocation::tryParse(id);
    if loc == null { return id; }
    let item_obj = ForgeRegistriesItem::ITEMS.getValue(loc);
    if item_obj == null { return id; }
    let item = item_obj as Item;
    let stack = ItemStack::new(item as ItemLike, 1);
    return stack.getHoverName().getString();
}

fn ess_list_build_rows() -> [EssListRow] {
    // Reads the HC-side cache (`EssentialsNetworkPackets.hotc`) -- indexed directly, not aliased
    // into a local, so repeated per-frame reads never move the static.
    if ess_list_kind == ess_list_kind_homes {
        var out = [EssListRow { label: "", action_name: "", clickable: false }; ess_cache_homes.length];
        var i = 0;
        while i < ess_cache_homes.length {
            out[i] = EssListRow { label: "§7{ess_cache_homes[i]}", action_name: ess_cache_homes[i], clickable: true };
            i = i + 1;
        }
        return out;
    }
    if ess_list_kind == ess_list_kind_warps {
        var out = [EssListRow { label: "", action_name: "", clickable: false }; ess_cache_warps.length];
        var i = 0;
        while i < ess_cache_warps.length {
            out[i] = EssListRow { label: "§7{ess_cache_warps[i]}", action_name: ess_cache_warps[i], clickable: true };
            i = i + 1;
        }
        return out;
    }
    if ess_list_kind == ess_list_kind_kits {
        var out = [EssListRow { label: "", action_name: "", clickable: false }; ess_cache_kit_names.length];
        var i = 0;
        while i < ess_cache_kit_names.length {
            let ready = ess_cache_kit_secs[i] <= 0;
            var label = "§7{ess_cache_kit_names[i]} §8({ess_cache_kit_secs[i]}s)";
            if ready { label = "§a{ess_cache_kit_names[i]}"; }
            out[i] = EssListRow { label: label, action_name: ess_cache_kit_names[i], clickable: ready };
            i = i + 1;
        }
        return out;
    }
    var out = [EssListRow { label: "", action_name: "", clickable: false }; ess_cache_trash.length];
    var i = 0;
    while i < ess_cache_trash.length {
        let id = ess_cache_trash[i];
        out[i] = EssListRow { label: "§7{ess_list_display_name_of(id)} §8(click to remove)", action_name: id, clickable: true };
        i = i + 1;
    }
    return out;
}

struct EssListLayout {
    panel_x: Int,
    panel_y: Int,
    list_y: Int,
    list_h: Int,
}

fn ess_list_compute_layout(screen_w: Int, screen_h: Int) -> EssListLayout {
    let panel_w = ess_list_panel_w();
    let panel_h = ess_list_panel_h();
    let panel_x = (screen_w - panel_w) / 2;
    let panel_y = (screen_h - panel_h) / 2;
    return EssListLayout { panel_x: panel_x, panel_y: panel_y, list_y: panel_y + 26, list_h: panel_h - 34 };
}

// Which real row index (into `ess_list_build_rows()`'s own output) the mouse is currently over,
// or `-1` -- a pure function of the CURRENT scroll offset + layout, not a stored rect list (same
// "recompute every call" convention `EssentialsConfigScreenHc.hotc`'s own `ess_compute_layout`
// already uses), so `render`/`mouseClicked` always agree with no shared mutable cache needed.
fn ess_list_row_at(mx: Int, my: Int, layout: &EssListLayout, row_count: Int) -> Int {
    let panel_w = ess_list_panel_w();
    if mx < layout.panel_x + 6 || mx >= layout.panel_x + panel_w - 6 { return -1; }
    if my < layout.list_y || my >= layout.list_y + layout.list_h { return -1; }
    let visible_index = (my - layout.list_y) / ess_list_row_h();
    let row = ess_list_scroll + visible_index;
    if row < 0 || row >= row_count { return -1; }
    return row;
}

static ess_list_scroll: Int = 0;

struct HcEssentialsListScreen extends ScreenHc {}

impl HcEssentialsListScreen {
    override fn render(&self, gfx: GuiGraphicsHc, mx: Int, my: Int, partial_tick: Float) {
        EssentialsThemePaletteHc::refresh(PhoenixThemeHc::current());
        let window = Minecraft::getInstance().getWindow();
        let layout = ess_list_compute_layout(window.getGuiScaledWidth(), window.getGuiScaledHeight());
        let panel_w = ess_list_panel_w();
        let panel_h = ess_list_panel_h();

        EssentialsUIKitHc::drawModalChrome(&gfx, Minecraft::getInstance().font, window.getGuiScaledWidth(), window.getGuiScaledHeight(),
            layout.panel_x, layout.panel_y, panel_w, panel_h, 20, "§f{ess_list_title}");

        let rows = ess_list_build_rows();
        var max_scroll = rows.length - layout.list_h / ess_list_row_h();
        if max_scroll < 0 { max_scroll = 0; }
        if ess_list_scroll > max_scroll { ess_list_scroll = max_scroll; }
        if ess_list_scroll < 0 { ess_list_scroll = 0; }

        gfx.enableScissor(layout.panel_x + 6, layout.list_y, layout.panel_x + panel_w - 6, layout.list_y + layout.list_h);
        var ly = layout.list_y;
        var i = ess_list_scroll;
        while i < rows.length && ly + ess_list_row_h() <= layout.list_y + layout.list_h {
            let row = rows[i];
            let row_hov = row.clickable && mx >= layout.panel_x + 6 && mx < layout.panel_x + panel_w - 6 && my >= ly && my < ly + ess_list_row_h();
            if row_hov {
                gfx.fill(layout.panel_x + 6, ly, layout.panel_x + panel_w - 6, ly + ess_list_row_h(), 587202560); // 0x22FFFFFF
            }
            var color = EssentialsThemePaletteHc::TEXT_FAINT;
            if row.clickable { color = EssentialsThemePaletteHc::TEXT; }
            gfx.drawString(Minecraft::getInstance().font, row.label, layout.panel_x + 10, ly + 5, color);
            ly = ly + ess_list_row_h();
            i = i + 1;
        }
        gfx.disableScissor();

        if max_scroll > 0 {
            let track_x = layout.panel_x + panel_w - 4;
            var thumb_h = layout.list_h * layout.list_h / (layout.list_h + max_scroll * ess_list_row_h());
            if thumb_h < 10 { thumb_h = 10; }
            let thumb_y = layout.list_y + (ess_list_scroll * (layout.list_h - thumb_h)) / max_scroll;
            gfx.fill(track_x, layout.list_y, track_x + 2, layout.list_y + layout.list_h, 587202560); // 0x22FFFFFF
            gfx.fill(track_x, thumb_y, track_x + 2, thumb_y + thumb_h, -1996488449); // 0x88FFFFFF, signed Int32
        }

        if rows.length == 0 {
            var msg = ess_list_empty_message();
            if !ess_list_rendered_once { msg = "§8Loading..."; }
            gfx.drawCenteredString(Minecraft::getInstance().font, msg, layout.panel_x + panel_w / 2, layout.list_y + layout.list_h / 2 - 4, EssentialsThemePaletteHc::TEXT_FAINT);
        }

        let esc_label = "Esc to close";
        gfx.drawString(Minecraft::getInstance().font, "§8{esc_label}", layout.panel_x + panel_w - Minecraft::getInstance().font.width(esc_label) - 8, layout.panel_y + 7, EssentialsThemePaletteHc::TEXT_FAINT);

        ess_list_rendered_once = true;
    }

    override fn mouseClicked(&self, mx: Double, my: Double, button: Int) -> Bool {
        let window = Minecraft::getInstance().getWindow();
        let layout = ess_list_compute_layout(window.getGuiScaledWidth(), window.getGuiScaledHeight());
        let rows = ess_list_build_rows();
        let row_idx = ess_list_row_at(mx as Int, my as Int, &layout, rows.length);
        if row_idx < 0 { return false; }
        let row = rows[row_idx];
        if !row.clickable { return true; }

        if ess_list_kind == ess_list_kind_trash {
            let player = Minecraft::getInstance().player;
            if player != null {
                player.connection.sendCommand("essentialsautotrash remove {row.action_name}");
            }
            ess_send_request_sync(ess_list_kind);
            return true;
        }

        if ess_list_kind == ess_list_kind_homes {
            ess_send_gui_teleport(0, row.action_name);
        }
        if ess_list_kind == ess_list_kind_warps {
            ess_send_gui_teleport(1, row.action_name);
        }
        if ess_list_kind == ess_list_kind_kits {
            ess_send_claim_kit(row.action_name);
        }
        Minecraft::getInstance().setScreen(null);
        return true;
    }

    override fn mouseScrolled(&self, mx: Double, my: Double, delta: Double) -> Bool {
        let rows = ess_list_build_rows();
        let window = Minecraft::getInstance().getWindow();
        let layout = ess_list_compute_layout(window.getGuiScaledWidth(), window.getGuiScaledHeight());
        var max_scroll = rows.length - layout.list_h / ess_list_row_h();
        if max_scroll < 0 { max_scroll = 0; }
        var next = ess_list_scroll - (delta as Int);
        if next < 0 { next = 0; }
        if next > max_scroll { next = max_scroll; }
        ess_list_scroll = next;
        return true;
    }

    override fn keyPressed(&self, key_code: Int, scan_code: Int, modifiers: Int) -> Bool {
        // Escape goes back to the config screen (the real `onClose() -> minecraft.setScreen
        // (parent)` original behavior) -- a successful action click (`mouseClicked`, above)
        // closes everything instead (`setScreen(null)`), same real distinction the original
        // makes between "cancelled" and "did the thing."
        if key_code == 256 { // GLFW_KEY_ESCAPE
            open_essentials_config_screen_hc();
            return true;
        }
        return false;
    }

    override fn isPauseScreen(&self) -> Bool {
        return false;
    }
}

// The one real caller -- `EssentialsConfigScreenHc.hotc`'s own `ess_open_list`. Mirrors the
// original's own `init()`: resets scroll/loading state, sends a `RequestSyncPacket` to
// (re)populate `EssentialsClientCache`, then opens the screen.
pub fn open_essentials_list_screen_hc(kind: Int, title: String) {
    ess_list_kind = kind;
    ess_list_title = title;
    ess_list_scroll = 0;
    ess_list_rendered_once = false;
    ess_send_request_sync(kind);
    let screen = HcEssentialsListScreen::new(Component::literal(title) as Component);
    Minecraft::getInstance().setScreen(screen as ScreenHc);
}
