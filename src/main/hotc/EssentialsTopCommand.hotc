// --- Real port of TopCommand.java ---
//
// Same "call the real Java directly" approach every other ported command uses --
// `EssentialsHcServerBridgeHc::topLocation` is a direct copy of the original's own surface-height
// computation (heightmap lookup + `NamedLocation` construction), and the teleport itself goes
// through the real `TeleportExecutor` (warmup/cooldown/cancel logic), same as every other
// teleporting command in this project. `hc`-prefixed literal, same side-by-side-pilot reasoning;
// the real `/top` stays registered and untouched. Same disclosed cooldown-pool simplification as
// `EssentialsWarpCommands.hotc` (4-arg overload, not the original's `TOP_COOLDOWN_SECONDS`).

fn hc_top(source: CommandSourceStackHc) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    let target = EssentialsHcServerBridgeHc::topLocation(player);
    if target == null { return 0; }
    TeleportExecutorHc::request(player, target, "top", "the surface");
    return 1;
}

pub fn register_real_top_command(dispatcher: CommandDispatcherSrc) {
    let top_builder = CommandsHc::literal("hctop").executes(|ctx| {
        return hc_top(ctx.getSource() as CommandSourceStackHc);
    });
    dispatcher.register(top_builder as LiteralArgumentBuilderSrc);
}
