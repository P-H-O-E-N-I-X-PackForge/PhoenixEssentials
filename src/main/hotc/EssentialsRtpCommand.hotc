// --- Real port of RtpCommand.java ---
//
// Same "call the real Java directly" approach every other ported command uses -- the whole flow
// (allowed-dimension config check, the real `RtpFinder` safe-spot search, the distance/tries
// detail, the real 7-arg `TeleportExecutor` with `RTP_COOLDOWN_SECONDS`) is a direct Java copy
// reached through ONE call returning `String?` (`null` = success, else the error to show).
// `hc`-prefixed literal, same side-by-side-pilot reasoning; the real `/rtp` stays registered.

fn hc_rtp(source: CommandSourceStackHc) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    let error = EssentialsHcServerBridgeHc::rtp(player);
    if error != null {
        source.sendFailure(Component::literal(error) as Component);
        return 0;
    }
    return 1;
}

pub fn register_real_rtp_command(dispatcher: CommandDispatcherSrc) {
    let rtp_builder = ess_literal("rtp", "hcrtp", "RTP").executes(|ctx| {
        return hc_rtp(ctx.getSource() as CommandSourceStackHc);
    });
    dispatcher.register(rtp_builder as LiteralArgumentBuilderSrc);
}
