

struct AfkSyncPacket {
    afk: Int,
}

impl AfkSyncPacket {
    fn encode(&self, buf: FriendlyByteBuf) {
        buf.writeVarInt(self.afk);
    }

    static fn decode(buf: FriendlyByteBuf) -> AfkSyncPacket {
        return AfkSyncPacket { afk: buf.readVarInt() };
    }

    fn on_received(&self) {
        EssentialsHcAfkOverlayHc::setActive(self.afk != 0);
    }
}

extern class EssentialsHcAfkOverlayHc = "net.phoenixvine.essentials.client.EssentialsHcAfkOverlay" {
    static fn setActive(afk: Bool);
    static fn isActive() -> Bool;
    static fn label() -> String;
}

pub fn register_afk_packet(channel: &SimpleChannel, id: Int) {
    let cls = class("AfkSyncPacket") as JClassNet;
    channel.registerMessage(
        id,
        cls,
        |pkt, buf| { (pkt as AfkSyncPacket).encode(buf as FriendlyByteBuf); },
        |buf| { return AfkSyncPacket::decode(buf as FriendlyByteBuf) as PhoenixObject4Net; },
        |pkt, ctx| {
            let real_ctx = EssentialsNetUnwrapHc::unwrapSupplier(ctx) as NetworkEventContextHc;
            let packet = pkt as AfkSyncPacket;
            real_ctx.enqueueWork(|| { packet.on_received(); });
        }
    );
}

pub fn send_afk_state(player: ServerPlayer, afk: Bool) {
    let chan = ess_hc_channel;
    if chan == null { return; }
    var flag = 0;
    if afk { flag = 1; }
    let target = PacketDistributorHc::PLAYER.with(|| { return player as PhoenixObject4Net; });
    chan.send(target, AfkSyncPacket { afk: flag } as PhoenixObject4Net);
}

pub fn render_afk_overlay(gfx: GuiGraphicsHc, screen_w: Int, screen_h: Int) {
    if !EssentialsSettingsHc::get().isShowAfkOverlay() { return; }
    if !EssentialsHcAfkOverlayHc::isActive() { return; }
    EssentialsThemePaletteHc::refresh(PhoenixThemeHc::current());

    let text = EssentialsHcAfkOverlayHc::label();
    let text_w = Minecraft::getInstance().font.width(text);
    let box_w = text_w + 16;
    let box_h = 16;
    let box_x = (screen_w - box_w) / 2;
    let box_y = 6;

    gfx.fill(box_x, box_y, box_x + box_w, box_y + box_h, EssentialsThemePaletteHc::PANEL);
    EssentialsUIKitHc::drawBorder(&gfx, box_x, box_y, box_w, box_h, EssentialsThemePaletteHc::ACCENT);
    gfx.drawCenteredString(Minecraft::getInstance().font, text, box_x + box_w / 2, box_y + 4, EssentialsThemePaletteHc::TEXT);
}
