// --- Real port of PlayerInfoCommand.java ---
//
// Same "call the real Java directly" approach every other ported command uses -- the report itself
// (gamemode, health/food, playtime, home count, AFK) is a direct Java copy in
// `EssentialsHcServerBridge::playerInfo`, returned as one newline-joined string (or `null` if the
// target has no essentials data). Plain text, no section-sign colors -- the only intentional
// difference from the original. `hc`-prefixed literal, same side-by-side-pilot reasoning; the real
// `/playerinfo` stays registered and untouched.

fn hc_player_info(source: CommandSourceStackHc, target: ServerPlayer) -> Int {
    let report = EssentialsHcServerBridgeHc::playerInfo(target);
    if report == null { return 0; }
    source.sendSuccess(|| { return Component::literal(report) as JObjectCmd; }, false);
    return 1;
}

fn hc_player_info_self(source: CommandSourceStackHc) -> Int {
    let player = source.getPlayer();
    if player == null { return 0; }
    return hc_player_info(source, player);
}

fn hc_player_info_named(source: CommandSourceStackHc, target_name: String) -> Int {
    let target = source.getServer().getPlayerList().getPlayerByName(target_name);
    if target == null {
        source.sendFailure(Component::literal("Player \"{target_name}\" isn't online.") as Component);
        return 0;
    }
    return hc_player_info(source, target);
}

pub fn register_real_playerinfo_command(dispatcher: CommandDispatcherSrc) {
    let player_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc).executes(|ctx| {
        return hc_player_info_named(ctx.getSource() as CommandSourceStackHc, StringArgumentTypeSrc::getString(ctx, "player"));
    });
    let info_builder = ess_literal("playerinfo", "hcplayerinfo", "PLAYERINFO")
        .executes(|ctx| { return hc_player_info_self(ctx.getSource() as CommandSourceStackHc); })
        .then(player_arg);
    dispatcher.register(info_builder as LiteralArgumentBuilderSrc);
}
