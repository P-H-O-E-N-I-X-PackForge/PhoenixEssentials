

fn hc_god_resolve(source: &CommandSourceStackHc, target_name: String) -> ServerPlayer {
    let target = source.getServer().getPlayerList().getPlayerByName(target_name);
    if target == null {
        source.sendFailure(Component::literal("Player \"{target_name}\" isn't online.") as Component);
    }
    return target;
}

fn hc_toggle_god(source: &CommandSourceStackHc, target: ServerPlayer, named: Bool) -> Int {
    var abilities = target.getAbilities();
    let now_invulnerable = !abilities.invulnerable;
    abilities.invulnerable = now_invulnerable;
    target.onUpdateAbilities();
    var status = "disabled.";
    if now_invulnerable { status = "enabled."; }
    target.sendSystemMessage(Component::literal("God mode {status}") as Component);
    if named {
        let display_name = target.getGameProfile().getName();
        source.sendSuccess(|| { return Component::literal("Set god mode for {display_name} to {now_invulnerable}.") as JObjectCmd; }, true);
    }
    return 1;
}

fn hc_toggle_fly(source: &CommandSourceStackHc, target: ServerPlayer, named: Bool) -> Int {
    var abilities = target.getAbilities();
    let now_flying = !abilities.mayfly;
    abilities.mayfly = now_flying;
    if !now_flying { abilities.flying = false; }
    target.onUpdateAbilities();
    var status = "disabled.";
    if now_flying { status = "enabled."; }
    target.sendSystemMessage(Component::literal("Flight {status}") as Component);
    if named {
        let display_name = target.getGameProfile().getName();
        source.sendSuccess(|| { return Component::literal("Set flight for {display_name} to {now_flying}.") as JObjectCmd; }, true);
    }
    return 1;
}

pub fn register_real_god_fly_commands(dispatcher: CommandDispatcherSrc) {
    let god_player_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc)
        .requires(|src| { return ess_op_required(src); })
        .executes(|ctx| {
        let source = ctx.getSource() as CommandSourceStackHc;
        let target = hc_god_resolve(&source, StringArgumentTypeSrc::getString(ctx, "player"));
        if target == null { return 0; }
        return hc_toggle_god(&source, target, true);
    });
    let god_builder = ess_literal("god", "hcgod", "GOD")
        .executes(|ctx| {
            let source = ctx.getSource() as CommandSourceStackHc;
            let player = source.getPlayer();
            if player == null { return 0; }
            return hc_toggle_god(&source, player, false);
        })
        .then(god_player_arg);
    dispatcher.register(god_builder as LiteralArgumentBuilderSrc);

    let fly_player_arg = CommandsHc::argument("player", StringArgumentTypeSrc::word() as ArgumentTypeSrc)
        .requires(|src| { return ess_op_required(src); })
        .executes(|ctx| {
        let source = ctx.getSource() as CommandSourceStackHc;
        let target = hc_god_resolve(&source, StringArgumentTypeSrc::getString(ctx, "player"));
        if target == null { return 0; }
        return hc_toggle_fly(&source, target, true);
    });
    let fly_builder = ess_literal("fly", "hcfly", "FLY")
        .executes(|ctx| {
            let source = ctx.getSource() as CommandSourceStackHc;
            let player = source.getPlayer();
            if player == null { return 0; }
            return hc_toggle_fly(&source, player, false);
        })
        .then(fly_player_arg);
    dispatcher.register(fly_builder as LiteralArgumentBuilderSrc);
}
